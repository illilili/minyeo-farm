server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/minyeo_farm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: minyeo
    password: your_db_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true
    open-in-view: false
  jackson:
    time-zone: Asia/Seoul

logging:
  level:
    org.hibernate.SQL: debug
    com.minyeo.farm: info

app:
  admin:
    naver-provider-user-id: "네이버_소셜_로그인_후_콘솔에서_확인"
  jwt:
    secret: "최소_32자_이상의_랜덤_문자열"
    access-token-expire-seconds: 86400
  naver:
    client-id: 네이버_클라이언트_ID
    client-secret: 네이버_클라이언트_시크릿
    redirect-uri: http://localhost:8080/api/auth/naver/callback
  scheduler:
    pending-order-cleanup-enabled: true
  toss:
    secret-key: test_sk_xxxxxxx   # 토스페이먼츠 테스트 키
    confirm-url: https://api.tosspayments.com/v1/payments/confirm
    cancel-url-template: https://api.tosspayments.com/v1/payments/%s/cancel

  # ── AWS S3 ──────────────────────────────────────────────
  # s3:
  #   region: ap-northeast-2
  #   bucket: your-bucket-name
  #   access-key: AKIA...
  #   secret-key: xxxx
  #   endpoint:        # 비워두기 (AWS 기본값)
  #   public-url:      # 비워두기 (자동 구성)

  # ── Cloudflare R2 ────────────────────────────────────────
  s3:
    region: auto
    bucket: your-r2-bucket-name
    access-key: R2_ACCESS_KEY_ID
    secret-key: R2_SECRET_ACCESS_KEY
    endpoint: https://<account-id>.r2.cloudflarestorage.com
    public-url: https://pub-xxxx.r2.dev   # R2 공개 버킷 URL 또는 커스텀 도메인
